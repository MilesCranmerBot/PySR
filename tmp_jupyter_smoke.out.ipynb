   "source": [
    "import numpy as np\n",
    "from pysr import PySRRegressor\n",
    "X=np.random.randn(40,3); y=X[:,0]-X[:,1]\n",
    "m=PySRRegressor(niterations=2,populations=3,progress=True,verbosity=1)\n",
    "m.fit(X,y)\n",
    "print('NB_FIT_DONE')\n"
   ]
  }
